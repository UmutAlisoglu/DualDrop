<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral dark palette (Android 10+ system dark theme). On Android 12+, Material You dynamic color
         overrides these at runtime. -->
    <color name="osmo_bg">#0A0E13</color>
    <color name="osmo_surface">#121922</color>
    <color name="osmo_surface_dim">#1A2330</color>
    <color name="osmo_ink">#EDF2F7</color>
    <color name="osmo_muted">#8B98A8</color>
    <color name="osmo_accent">#3DD9CC</color>
    <color name="osmo_on_accent">#00201D</color>
    <color name="osmo_green">#46DB9B</color>
    <color name="osmo_track">#243040</color>
    <color name="osmo_danger">#FF6B6B</color>
    <color name="osmo_amber">#F5B84A</color>

    <!-- Pill semantic indicators, brightened for dark. -->
    <color name="osmo_warn">#EFB84E</color>
    <color name="osmo_low">#EF6A5E</color>

    <!-- The pill behind a swiped camera row: darker than the card, so it still reads as recessed. -->
    <color name="osmo_swipe_well">#06090D</color>
</resources>
